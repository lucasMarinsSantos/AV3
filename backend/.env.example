# Banco de dados MySQL 8 (ajuste usuário/senha/host conforme seu ambiente)
DATABASE_URL="mysql://seu_usuario:sua_senha@localhost:3306/aerocode"

# Porta HTTP do backend
PORT=3000

# Ambiente de execução
NODE_ENV=development

# Autenticação JWT
# Chave usada para assinar e validar tokens de login
JWT_SECRET="jwt-secret-av3-dev"

# Métricas e relatório de qualidade AV3
# URL base da API usada pelo script backend/scripts/runMetricsAndGenerateReport.ts
BASE_URL_API="http://localhost:3000/api"

# Rota alvo para testes de carga de métricas (precisa existir no backend)
METRICS_TARGET_ROUTE="/aeronaves"

# Número de lotes de requisições por cenário (1, 5 e 10 usuários)
METRICS_REQS_POR_CENARIO=20

# Token JWT usado pelos scripts de métricas para autenticar nas rotas protegidas
# Para usar: faça login na aplicação, copie o token e cole aqui
METRICS_AUTH_TOKEN=""
